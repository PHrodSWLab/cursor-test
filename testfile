        if (!optionsContainer) return;
        var answered = false;
        scenario.responses.forEach(function(response, index) {
          var btn = document.createElement('div');
          btn.className = 'response-option';
          btn.innerHTML = '<strong style="color:rgba(147,51,234,0.7);margin-right:8px;">' + String.fromCharCode(65 + index) + '.</strong>' + response.text;
          btn.addEventListener('mouseenter', function() { if (!answered) SFX.hover(); });
          btn.addEventListener('click', function() {
            if (answered) return;
            answered = true;
            ch2HandleBattleResponse(response, btn, nextScene, scenarioIndex);
          });
          optionsContainer.appendChild(btn);
        });

        var nextBtn = document.getElementById('ch2-next-battle');
        if (nextBtn) {
          nextBtn.addEventListener('mouseenter', function() { SFX.hover(); });
          nextBtn.addEventListener('click', function() {
            SFX.click();
            var tracker = document.querySelector('.score-tracker');
            if (tracker && tracker.parentNode) tracker.parentNode.removeChild(tracker);
            ch2TransitionToScene(nextScene);
          });
        }
      }

      function ch2HandleBattleResponse(response, btn, nextScene, scenarioIndex) {
        SFX.click();
        document.querySelectorAll('.response-option').forEach(function(opt) {
          if (opt !== btn) opt.classList.add('disabled');
        });

        if (response.correct) {
          btn.classList.add('correct');
          SFX.correct();
          screenFlash('rgba(76,175,80,0.15)', 200);
          var rect = btn.getBoundingClientRect();
          ParticleSystem.burst(rect.left + 100, rect.top + 10, 15, 'green');
          ch2AddXP(15);
        } else {
          btn.classList.add('incorrect');
          SFX.incorrect();
          screenFlash('rgba(244,67,54,0.15)', 200);
          var allOpts = document.querySelectorAll('.response-option');
          var correctIdx = -1;
          ch2BattleScenarios[scenarioIndex].responses.forEach(function(r, i) { if (r.correct) correctIdx = i; });
          if (correctIdx >= 0 && allOpts[correctIdx]) {
            setTimeout(function() {
              allOpts[correctIdx].classList.remove('disabled');
              allOpts[correctIdx].classList.add('correct');
              allOpts[correctIdx].style.opacity = '1';
            }, 800);
          }
          ch2AddXP(3);
        }

        var feedbackArea = document.getElementById('ch2-feedback-area');
        if (feedbackArea) {
          feedbackArea.innerHTML = '<div class="feedback-panel ' + (response.correct ? 'success' : 'failure') + '">' +
            '<h4>' + (response.correct ? '✓ 優秀！' : '✗ 需要改進') + '</h4>' +
            '<p style="line-height:1.6;margin-top:10px;">' + response.feedback + '</p>' +
          '</div>';
        }

        ch2GameState.updateStats(response.outcome.kindness, response.outcome.power, response.outcome.wisdom);
        if (response.correct) {
          ch2GameState.playerData.battleScore += 20;
          ch2UpdateScoreTracker();
        }

        setTimeout(function() {
          var nextBtn = document.getElementById('ch2-next-battle');
          if (nextBtn) nextBtn.style.display = 'block';
          if (feedbackArea) feedbackArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 1000);
      }

