      var healthyCount = 0, exploitCount = 0;

      var hint = document.createElement('div');
      hint.className = 'hint-hand';
      hint.textContent = '👆';
      hint.style.cssText = 'bottom: 35%; left: 30%;';
      var tutContainer = r.querySelector('.tutorial-container');
      if (tutContainer) tutContainer.appendChild(hint);

      var shuffled = scenarios.slice().sort(function() { return Math.random() - 0.5; });

      shuffled.forEach(function(s, idx) {
        var card = document.createElement('div');
        card.className = 'drag-card';
        card.draggable = true;
        card.dataset.id = s.id;
        card.dataset.answer = s.answer;
        card.innerHTML = '<span style="margin-right:6px;">' + s.icon + '</span>' + s.text + '<span class="card-icon">✓</span>';

        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        setTimeout(function() {
          card.style.transition = 'all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, 100 + idx * 60);

        card.addEventListener('dragstart', function(e) {
          if (card.classList.contains('placed')) { e.preventDefault(); return; }
          if (hint && hint.parentNode) hint.parentNode.removeChild(hint);
          SFX.pickup();
