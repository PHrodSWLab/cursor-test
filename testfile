      shuffled.forEach(function(s, idx) {
        var card = document.createElement('div');
        card.className = 'drag-card';
        card.draggable = true;
        card.dataset.id = s.id;
        card.dataset.answer = s.answer;
        card.innerHTML = '<span style="margin-right:6px;">' + s.icon + '</span>' + s.text + '<span class="card-icon">✓</span>';

        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        setTimeout(function() {
          card.style.transition = 'all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, 100 + idx * 60);

        card.addEventListener('dragstart', function(e) {
          if (card.classList.contains('placed')) { e.preventDefault(); return; }
          if (hint && hint.parentNode) hint.parentNode.removeChild(hint);
          SFX.pickup();
          e.dataTransfer.setData('text/plain', s.id + '|' + s.answer);
          e.dataTransfer.effectAllowed = 'move';
          card.style.opacity = '0.5';
        });
        card.addEventListener('dragend', function() { if (!card.classList.contains('placed')) card.style.opacity = '1'; });

        setupTouchDrag(card, s, hint);
        document.getElementById('cards-pool').appendChild(card);
      });

      document.querySelectorAll('.drop-zone').forEach(function(zone) {
        zone.addEventListener('dragover', function(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', function() { zone.classList.remove('drag-over'); });
        zone.addEventListener('drop', function(e) {
          e.preventDefault(); zone.classList.remove('drag-over');
          var raw = e.dataTransfer.getData('text/plain');
          if (!raw) return;
          var data = raw.split('|');
          if (data.length < 2) return;
          processCardDrop(parseInt(data[0], 10), data[1], zone.dataset.zone, e.clientX, e.clientY);
        });
      });

      function processCardDrop(id, ans, zoneType, mx, my) {
        if (isNaN(id)) return;
        var card = document.querySelector('.drag-card[data-id="' + id + '"]');
        if (!card || card.classList.contains('placed')) return;

        attempts++;
        var attEl = document.getElementById('attempts');
        if (attEl) attEl.textContent = attempts;
        SFX.drop();

        if (ans === zoneType) {
          correct++; streak++;
          if (streak > maxStreak) maxStreak = streak;
          var ccEl = document.getElementById('correct-count');
          if (ccEl) ccEl.textContent = correct;
          var sdEl = document.getElementById('streak-display');
          if (sdEl) sdEl.textContent = '🔥 連續 ' + streak;
          card.classList.add('correct', 'placed');
          card.draggable = false;
          SFX.correct();
          screenFlash('rgba(76, 175, 80, 0.15)', 200);
          floatFeedback('+10 XP', mx || 400, (my || 300) - 20, '#4CAF50');
          ParticleSystem.burst(mx || 400, my || 300, 12, 'green');
          addXP(10);

          if (zoneType === 'healthy') healthyCount++;
          else exploitCount++;
          updateZoneCounts();

          if (streak >= 3) {
            floatFeedback('🔥 x' + streak + '!', (mx || 400) + 30, (my || 300) - 50, '#FFD700');
            addXP(5);
          }

          var scenario = scenarios.find(function(sc) { return sc.id === id; });
          if (scenario) {
            var tip = document.createElement('div');
            tip.style.cssText = 'position:absolute;bottom:5px;left:5px;right:5px;font-size:10px;color:#4CAF50;opacity:0;transition:opacity 0.3s;';
            tip.textContent = '💡 ' + scenario.explanation;
            card.appendChild(tip);
            setTimeout(function() { tip.style.opacity = '1'; }, 100);
          }
        } else {
          streak = 0;
          var sdEl2 = document.getElementById('streak-display');
          if (sdEl2) sdEl2.textContent = '🔥 連續 0';
          card.classList.add('incorrect');
          SFX.incorrect();
          screenFlash('rgba(244, 67, 54, 0.15)', 200);
          floatFeedback('✗', mx || 400, (my || 300) - 20, '#F44336');
          setTimeout(function() { card.classList.remove('incorrect'); card.style.opacity = '1'; }, 600);
        }

        checkCompletion();
      }

      function checkCompletion() {
        var allPlaced = document.querySelectorAll('.drag-card.placed').length;
        if (allPlaced === totalCards) {
          setTimeout(function() {
            SFX.levelUp();
            addXP(20);
            var streakMsg = maxStreak >= 3 ? ' 最高連續 ' + maxStreak + ' 題！' : '';
            showDialogue({
              speaker: "系統",
              text: '🎉 全部完成！答對 ' + correct + ' / ' + totalCards + ' 題。' + streakMsg,
              choices: [{ text: "▶ 繼續", onSelect: function() { transitionToScene(3); } }]
            });
          }, 800);
        } else if (attempts >= totalCards + 10) {
          // Safety: too many wrong attempts
          setTimeout(function() {
            if (correct >= 7) {
              showDialogue({ speaker: "系統", text: '通過！答對 ' + correct + ' 題。', choices: [{ text: "▶ 繼續", onSelect: function() { transitionToScene(3); } }] });
            } else {
              showDialogue({ speaker: "系統", text: '答對 ' + correct + ' 題，需要 7 題。再試一次？', choices: [
                { text: "🔄 重試", onSelect: function() { loadScene(2); } },
                { text: "▶ 跳過", onSelect: function() { transitionToScene(3); } }
              ] });
            }
          }, 800);
        }
      }

      function updateZoneCounts() {
        var zones = document.querySelectorAll('.zone-count');
        if (zones[0]) zones[0].textContent = healthyCount + ' 張';
        if (zones[1]) zones[1].textContent = exploitCount + ' 張';
      }

      window._processCardDrop = processCardDrop;
    }

    /* ===== TOUCH DRAG ===== */
    function setupTouchDrag(card, scenario, hint) {
      var clone = null;
      var startX = 0, startY = 0, hasMoved = false;
      var gameContainer = getGameContainer();

      function updateClonePosition(touch) {
        if (!clone || !gameContainer) return;
        var rect = gameContainer.getBoundingClientRect();
        clone.style.left = (touch.clientX - rect.left - 110) + 'px';
        clone.style.top = (touch.clientY - rect.top - 25) + 'px';
      }

      card.addEventListener('touchstart', function(e) {
        if (card.classList.contains('placed')) return;
        var touch = e.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        hasMoved = false;
      }, { passive: true });

      card.addEventListener('touchmove', function(e) {
        if (card.classList.contains('placed')) return;
        var touch = e.touches[0];
        var dx = Math.abs(touch.clientX - startX);
        var dy = Math.abs(touch.clientY - startY);

        if (!hasMoved && (dx > 10 || dy > 10)) {
          hasMoved = true;
          if (hint && hint.parentNode) hint.parentNode.removeChild(hint);
          SFX.pickup();
          clone = card.cloneNode(true);
          clone.className = 'drag-card touch-dragging';
          updateClonePosition(touch);
          if (gameContainer) gameContainer.appendChild(clone);
          card.style.opacity = '0.4';
        }

        if (clone) {
          e.preventDefault();
          updateClonePosition(touch);
          document.querySelectorAll('.drop-zone').forEach(function(zone) {
            var rect = zone.getBoundingClientRect();
            if (touch.clientX >= rect.left && touch.clientX <= rect.right &&
                touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
              zone.classList.add('drag-over');
            } else { zone.classList.remove('drag-over'); }
          });
        }
      }, { passive: false });

      card.addEventListener('touchend', function(e) {
        if (!clone) {
          if (!card.classList.contains('placed')) card.style.opacity = '1';
          return;
        }
        var touch = e.changedTouches[0];
        if (clone.parentNode) clone.parentNode.removeChild(clone);
        clone = null;
        if (!card.classList.contains('placed')) card.style.opacity = '1';
        document.querySelectorAll('.drop-zone').forEach(function(zone) {
          zone.classList.remove('drag-over');
          var rect = zone.getBoundingClientRect();
          if (touch.clientX >= rect.left && touch.clientX <= rect.right &&
              touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
            if (typeof window._processCardDrop === 'function')
              window._processCardDrop(scenario.id, scenario.answer, zone.dataset.zone, touch.clientX, touch.clientY);
          }
        });
      }, { passive: true });
    }

