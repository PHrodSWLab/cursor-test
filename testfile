    function initMenuStarfield() {
      var menu = document.getElementById('game-menu');
      var canvas = document.getElementById('menu-starfield');
      if (!menu || !canvas) return;
      var ctx = canvas.getContext('2d');
      if (!ctx) return;

      function resize() {
        canvas.width = menu.clientWidth;
        canvas.height = menu.clientHeight;
      }

      function initStars() {
        _menuStars = [];
        var total = 160;
        for (var i = 0; i < total; i++) {
          _menuStars.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 1.4 + 0.2,
            o: Math.random(),
            s: Math.random() * 0.005 + 0.002,
            d: Math.random() < 0.5 ? 1 : -1
          });
        }
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        _menuStars.forEach(function(s) {
          s.o += s.s * s.d;
          if (s.o > 1 || s.o < 0.1) s.d *= -1;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255,255,255,' + s.o + ')';
          ctx.fill();
        });
        _menuStarAnimId = requestAnimationFrame(draw);
      }

      resize();
      initStars();
      if (_menuStarAnimId) cancelAnimationFrame(_menuStarAnimId);
      draw();
      window.addEventListener('resize', function() {
        resize();
        initStars();
      });
    }

    function stopMenuStarfield() {
      if (_menuStarAnimId) {
        cancelAnimationFrame(_menuStarAnimId);
        _menuStarAnimId = null;
      }
    }

