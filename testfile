          }
        }

        setTimer(setInterval(function() {
          if (i < opts.text.length && !skipTyping) {
            textEl.textContent += opts.text.charAt(i);
            charCount++;
            if (charCount % (typeSfxEvery || 2) === 0) SFX.typeChar();
            i++;
          } else {
            finishTyping();
          }
        }, opts.typeSpeed || defaultTypeSpeed || 25));

        textEl.addEventListener('click', function skipHandler() {
          if (!typingDone) {
            skipTyping = true;
            finishTyping();
          }
          textEl.removeEventListener('click', skipHandler);
        });
      }

      function transitionToScene(n, cfg) {
        var state = cfg.state;
        if (!state || state._transitioning) return;
        state._transitioning = true;

        if (typeof cfg.clearTimers === 'function') cfg.clearTimers();
        var box = document.getElementById('dialogue-box');
        if (box) box.classList.remove('active');
        SFX.transition();

        var r = document.getElementById('scene-renderer');
        if (!r) { state._transitioning = false; return; }

        var outDuration = (typeof cfg.outDuration === 'number') ? cfg.outDuration : 0.4;
        var inDuration = (typeof cfg.inDuration === 'number') ? cfg.inDuration : 0.5;
        var fallbackDelay = (typeof cfg.fallbackDelay === 'number') ? cfg.fallbackDelay : 400;
        var useScale = cfg.useScale !== false;
        var scaleOut = (typeof cfg.scaleOut === 'number') ? cfg.scaleOut : 0.98;
        var scaleIn = (typeof cfg.scaleIn === 'number') ? cfg.scaleIn : 1.02;
        var stepXP = (typeof cfg.transitionXP === 'number') ? cfg.transitionXP : 5;

        function applyScene() {
          state.currentScene = n;
          cfg.updateProgress();
          cfg.addXP(stepXP);
          cfg.loadScene(n);
        }

        if (typeof gsap !== 'undefined') {
          var outVars = { opacity: 0, duration: outDuration, ease: 'power2.in', onComplete: function() {
            applyScene();
            if (useScale) {
              gsap.fromTo(r, { opacity: 0, scale: scaleIn }, {
                opacity: 1, scale: 1, duration: inDuration, ease: 'power2.out',
                onComplete: function() { state._transitioning = false; }
              });
            } else {
              gsap.to(r, {
                opacity: 1, duration: inDuration, ease: 'power2.out',
                onComplete: function() { state._transitioning = false; }
              });
            }
          }};
          if (useScale) outVars.scale = scaleOut;
          gsap.to(r, outVars);
        } else {
          r.style.opacity = '0';
          setTimeout(function() {
            applyScene();
            r.style.opacity = '1';
            state._transitioning = false;
          }, fallbackDelay);
        }
      }

      return {
        applyXP: applyXP,
        syncXP: syncXP,
        resetXP: resetXP,
        updateProgress: updateProgress,
        showDialogue: showDialogue,
        transitionToScene: transitionToScene
      };
    })();

