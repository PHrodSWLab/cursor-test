      textEl.textContent = '';
      textEl.classList.remove('typing-done');
      optionsEl.innerHTML = '';

      var i = 0, skipTyping = false;
      var charCount = 0;
      var typingDone = false;

      function finishTyping() {
        if (typingDone) return;
        typingDone = true;
        if (_activeTypeInterval) { clearInterval(_activeTypeInterval); _activeTypeInterval = null; }
        textEl.textContent = opts.text;
        textEl.classList.add('typing-done');

        if (opts.choices) {
          opts.choices.forEach(function(c, idx) {
            var btn = document.createElement('button');
            btn.className = 'option-button appear';
            btn.style.animationDelay = (idx * 0.12) + 's';
            btn.textContent = c.text;
            btn.addEventListener('mouseenter', function() { SFX.hover(); });
            btn.addEventListener('click', function() {
              SFX.click();
              box.classList.remove('active');
              if (typeof c.onSelect === 'function') c.onSelect();
            });
            optionsEl.appendChild(btn);
          });
        } else if (opts.onComplete) {
          setTimeout(function() {
            box.classList.remove('active');
            opts.onComplete();
          }, opts.autoContinueDelay || 3000);
        }
      }

      _activeTypeInterval = setInterval(function() {
        if (i < opts.text.length && !skipTyping) {
          textEl.textContent += opts.text.charAt(i);
          charCount++;
          if (charCount % 2 === 0) SFX.typeChar();
          i++;
        } else {
          finishTyping();
        }
      }, opts.typeSpeed || 30);

      textEl.addEventListener('click', function skipHandler() {
        if (!typingDone) {
          skipTyping = true;
          finishTyping();
        }
        textEl.removeEventListener('click', skipHandler);
      });
    }

