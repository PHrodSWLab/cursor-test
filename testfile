      function ch4SetupSortTouchDrag(card, cardData) {
        var clone = null;
        var startX = 0, startY = 0;
        var hasMoved = false;

        card.addEventListener('touchstart', function(e) {
          if (card.classList.contains('placed')) return;
          var touch = e.touches[0];
          startX = touch.clientX;
          startY = touch.clientY;
          hasMoved = false;
        }, { passive: true });

        card.addEventListener('touchmove', function(e) {
          if (card.classList.contains('placed')) return;
          var touch = e.touches[0];
          if (!hasMoved && (Math.abs(touch.clientX - startX) > 10 || Math.abs(touch.clientY - startY) > 10)) {
            hasMoved = true;
            SFX.pickup();
            clone = card.cloneNode(true);
            clone.className = 'sort-card touch-dragging';
            var p0 = toContainerPoint(touch.clientX, touch.clientY);
            clone.style.left = (p0.x - 100) + 'px';
            clone.style.top = (p0.y - 20) + 'px';
            var c = ch4Container();
            if (c) c.appendChild(clone);
            card.style.opacity = '0.4';
          }
          if (clone) {
            e.preventDefault();
            var p = toContainerPoint(touch.clientX, touch.clientY);
            clone.style.left = (p.x - 100) + 'px';
            clone.style.top = (p.y - 20) + 'px';
            document.querySelectorAll('.sort-zone').forEach(function(zone) {
              var rect = zone.getBoundingClientRect();
              if (touch.clientX >= rect.left && touch.clientX <= rect.right && touch.clientY >= rect.top && touch.clientY <= rect.bottom) zone.classList.add('drag-over');
              else zone.classList.remove('drag-over');
            });
          }
        }, { passive: false });

        card.addEventListener('touchend', function(e) {
          if (!clone) {
            if (!card.classList.contains('placed')) card.style.opacity = '1';
            return;
          }
          var touch = e.changedTouches[0];
          if (clone.parentNode) clone.parentNode.removeChild(clone);
          clone = null;
          if (!card.classList.contains('placed')) card.style.opacity = '1';
          document.querySelectorAll('.sort-zone').forEach(function(zone) {
            zone.classList.remove('drag-over');
            var rect = zone.getBoundingClientRect();
            if (touch.clientX >= rect.left && touch.clientX <= rect.right && touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
              if (typeof ch4ProcessSortDrop === 'function') ch4ProcessSortDrop(cardData.id, cardData.ans, zone.dataset.zone, touch.clientX, touch.clientY);
            }
          });
        }, { passive: true });
      }

