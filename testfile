    /* ===== TOUCH DRAG ===== */
    function setupTouchDrag(card, scenario, hint) {
      var clone = null;
      var startX = 0, startY = 0, hasMoved = false;
      var gameContainer = getGameContainer();

      function updateClonePosition(touch) {
        if (!clone || !gameContainer) return;
        var rect = gameContainer.getBoundingClientRect();
        clone.style.left = (touch.clientX - rect.left - 110) + 'px';
        clone.style.top = (touch.clientY - rect.top - 25) + 'px';
      }

      card.addEventListener('touchstart', function(e) {
        if (card.classList.contains('placed')) return;
        var touch = e.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        hasMoved = false;
      }, { passive: true });

      card.addEventListener('touchmove', function(e) {
        if (card.classList.contains('placed')) return;
        var touch = e.touches[0];
        var dx = Math.abs(touch.clientX - startX);
        var dy = Math.abs(touch.clientY - startY);

        if (!hasMoved && (dx > 10 || dy > 10)) {
          hasMoved = true;
          if (hint && hint.parentNode) hint.parentNode.removeChild(hint);
          SFX.pickup();
          clone = card.cloneNode(true);
          clone.className = 'drag-card touch-dragging';
          updateClonePosition(touch);
          if (gameContainer) gameContainer.appendChild(clone);
          card.style.opacity = '0.4';
        }

        if (clone) {
          e.preventDefault();
          updateClonePosition(touch);
          document.querySelectorAll('.drop-zone').forEach(function(zone) {
            var rect = zone.getBoundingClientRect();
            if (touch.clientX >= rect.left && touch.clientX <= rect.right &&
                touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
              zone.classList.add('drag-over');
            } else { zone.classList.remove('drag-over'); }
          });
        }
      }, { passive: false });

      card.addEventListener('touchend', function(e) {
        if (!clone) {
          if (!card.classList.contains('placed')) card.style.opacity = '1';
          return;
        }
        var touch = e.changedTouches[0];
        if (clone.parentNode) clone.parentNode.removeChild(clone);
        clone = null;
        if (!card.classList.contains('placed')) card.style.opacity = '1';
        document.querySelectorAll('.drop-zone').forEach(function(zone) {
          zone.classList.remove('drag-over');
          var rect = zone.getBoundingClientRect();
          if (touch.clientX >= rect.left && touch.clientX <= rect.right &&
              touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
            if (typeof window._processCardDrop === 'function')
              window._processCardDrop(scenario.id, scenario.answer, zone.dataset.zone, touch.clientX, touch.clientY);
          }
        });
      }, { passive: true });
    }

