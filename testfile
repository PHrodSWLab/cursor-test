        titleEl.textContent = pct === 0 ? '尚未開始' : pct === 100 ? '🎉 課程完成！' : pct < 50 ? '旅程進行中' : '即將完成';
      }

      var map = document.getElementById('menu-starmap');
      if (!map) return;
      map.innerHTML = '';

      MENU_PARTS.forEach(function(part) {
        var block = document.createElement('div');
        block.className = 'part-block part-' + part.id;
        block.innerHTML =
          '<div class="part-header">' +
            '<div class="part-badge">' + part.id + '</div>' +
            '<div class="part-header-text">' +
              '<h3>' + part.label + '：' + part.name + '</h3>' +
              '<p>' + part.sub + '</p>' +
            '</div>' +
          '</div>' +
          '<div class="chapters-grid" id="menu-grid-' + part.id + '"></div>';
        map.appendChild(block);

        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              block.classList.add('visible');
              io.disconnect();
            }
          });
        }, { threshold: 0.1, root: menuApp || null });
        io.observe(block);

        var grid = block.querySelector('#menu-grid-' + part.id);
        part.chapters.forEach(function(ch) {
          var state = getMenuCardState(ch.n, done);
          var statusIcon = state === 'done' ? '✦' : state === 'current' ? '◉' : '🔒';
          var statusColor = state === 'done' ? 'var(--menu-gold)' : state === 'current' ? 'var(--menu-purple)' : 'rgba(255,255,255,0.2)';

          var card = document.createElement('a');
          card.className = 'ch-card ' + state;
          card.href = '#';
          card.innerHTML =
            (state === 'done' ? '<div class="ch-star">✦ ✦ ✦</div>' : '') +
            '<div class="ch-num">Chapter ' + ('0' + ch.n).slice(-2) + '</div>' +
            '<div class="ch-icon-row">' +
              '<div class="ch-icon">' + ch.icon + '</div>' +
              '<div class="ch-status" style="color:' + statusColor + ';">' + statusIcon + '</div>' +
            '</div>' +
            '<div class="ch-title">' + ch.title + '</div>' +
            '<div class="ch-subtitle">' + ch.sub + '</div>' +
            '<div class="ch-prog"><div class="ch-prog-fill"></div></div>';

          card.addEventListener('mouseenter', function(e) { showMenuTooltip(e, ch, state); });
          card.addEventListener('mousemove', moveMenuTooltip);
          card.addEventListener('mouseleave', hideMenuTooltip);

          card.addEventListener('click', function(e) {
            e.preventDefault();
            if (state === 'locked') return;
            SFX.click();
            if (ch.n === 1) {
              launchChapterOneFromMenu();
            } else {
              showToast('此單檔版本目前僅整合 Chapter 1');
            }
          });

          grid.appendChild(card);
        });
      });
    }

    function initGameMenu() {
      _menuTooltipEl = document.getElementById('menu-tooltip');
      renderGameMenu();
      initMenuStarfield();
    }

    /* ================================================================
       INITIALIZATION
       ================================================================ */
    function init() {
      var loadTimeout = setTimeout(function() {
        var overlay = document.getElementById('loading-overlay');
        if (overlay) { overlay.classList.add('fade-out'); setTimeout(function() { overlay.style.display = 'none'; }, 800); }
        startGame();
      }, 5000);

      function checkReady() {
        if (document.readyState === 'complete') {
          clearTimeout(loadTimeout);
          setTimeout(function() {
            var overlay = document.getElementById('loading-overlay');
            if (overlay) { overlay.classList.add('fade-out'); setTimeout(function() { overlay.style.display = 'none'; }, 800); }
            startGame();
          }, 2200);
        } else {
          setTimeout(checkReady, 200);
        }
      }
      checkReady();
    }

    var _gameStarted = false;
    function startGame() {
      if (_gameStarted) return;
      _gameStarted = true;

      ParticleSystem.init();
      initResetButton();

      // Initialize audio context on first user interaction
      var initAudioOnce = function() {
        SFX.click();
        document.removeEventListener('click', initAudioOnce);
        document.removeEventListener('touchstart', initAudioOnce);
      };
      document.addEventListener('click', initAudioOnce, { once: true });
      document.addEventListener('touchstart', initAudioOnce, { once: true });

      GameState.loadProgress();
      updateProgress();
      GameState.updateMoralCompass();
      // Restore XP bar
      var xpPct = Math.min(100, ((GameState.playerData.xp || 0) / 100) * 100);
      var xpFill = document.getElementById('xp-fill');
      if (xpFill) xpFill.style.width = xpPct + '%';

      if (GameState.currentScene === 0) GameState.currentScene = 1;
      loadScene(GameState.currentScene);
    }

    window.addEventListener('DOMContentLoaded', initGameMenu);

    // Handle visibility change — pause/resume particle system
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        // could pause animations here
      } else {
        ParticleSystem.resize();
      }
    });

    /* ===== WORDPRESS EMBED SAFETY ===== */
    (function() {
      if (!document.getElementById('game-container')) return;
      var style = document.createElement('style');
      style.textContent = '#game-container p{margin:0!important}#game-container br{display:inline}#game-container img{display:none}#game-container .wp-block-image{display:none}';
      document.head.appendChild(style);
    })();
  </script>
</body>
</html>
