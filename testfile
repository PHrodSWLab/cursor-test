  <script>
    /* ================================================================
       CDN LOADER — Load libs with timeout fallback (avoids render-blocking)
       ================================================================ */
    (function() {
      var libs = [
        'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
        'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js'
      ];
      var loaded = 0;
      libs.forEach(function(src) {
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = s.onerror = function() { loaded++; };
        document.head.appendChild(s);
      });
    })();

    /* ================================================================
       SOUND ENGINE - Web Audio API SFX Generator (No external files)
       ================================================================ */
    var SFX = (function() {
      var ctx = null;
      var masterVol = 0.3;
      var _enabled = true;

      function getCtx() {
        if (!_enabled) return null;
        if (!ctx) {
          try { ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) { _enabled = false; return null; }
        }
        if (ctx && ctx.state === 'suspended') { try { ctx.resume(); } catch(e) {} }
        return ctx;
      }

      function playTone(freq, type, duration, vol, rampDown) {
        var c = getCtx(); if (!c) return;
        try {
          var osc = c.createOscillator();
          var gain = c.createGain();
          osc.type = type || 'sine';
          osc.frequency.setValueAtTime(freq, c.currentTime);
          gain.gain.setValueAtTime((vol || 0.3) * masterVol, c.currentTime);
          if (rampDown !== false) gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + (duration || 0.3));
          osc.connect(gain); gain.connect(c.destination);
          osc.start(c.currentTime); osc.stop(c.currentTime + (duration || 0.3));
        } catch(e) {}
      }

      function playNoise(duration, vol) {
        var c = getCtx(); if (!c) return;
        try {
          var bufferSize = Math.floor(c.sampleRate * (duration || 0.1));
          if (bufferSize <= 0) return;
          var buffer = c.createBuffer(1, bufferSize, c.sampleRate);
          var data = buffer.getChannelData(0);
          for (var i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * 0.5;
          var src = c.createBufferSource(); src.buffer = buffer;
          var gain = c.createGain();
          gain.gain.setValueAtTime((vol || 0.15) * masterVol, c.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + (duration || 0.1));
          var filter = c.createBiquadFilter(); filter.type = 'highpass'; filter.frequency.value = 3000;
          src.connect(filter); filter.connect(gain); gain.connect(c.destination);
          src.start(c.currentTime);
        } catch(e) {}
      }

      return {
        typeChar: function() { playTone(800 + Math.random() * 400, 'square', 0.03, 0.06); },
        click: function() { playTone(600, 'sine', 0.08, 0.2); playNoise(0.03, 0.1); },
        hover: function() { playTone(1200, 'sine', 0.05, 0.08); },
        correct: function() {
          playTone(523, 'sine', 0.15, 0.25);
          setTimeout(function() { playTone(659, 'sine', 0.15, 0.25); }, 100);
          setTimeout(function() { playTone(784, 'sine', 0.3, 0.3); }, 200);
        },
        incorrect: function() {
          playTone(300, 'square', 0.15, 0.2);
          setTimeout(function() { playTone(250, 'square', 0.25, 0.2); }, 120);
        },
        drop: function() { playTone(400, 'sine', 0.1, 0.2); playNoise(0.05, 0.15); },
        pickup: function() { playTone(500, 'sine', 0.08, 0.15); },
        transition: function() {
          playTone(400, 'sine', 0.4, 0.15);
          setTimeout(function() { playTone(600, 'sine', 0.4, 0.15); }, 200);
        },
        levelUp: function() {
          var notes = [523, 659, 784, 1047];
          notes.forEach(function(n, i) { setTimeout(function() { playTone(n, 'sine', 0.2, 0.25); }, i * 120); });
        },
        submit: function() { playTone(700, 'sine', 0.1, 0.2); setTimeout(function(){ playTone(900, 'sine', 0.15, 0.15); }, 50); },
        compassPulse: function() { playTone(350, 'sine', 0.3, 0.1); },
        dialogueOpen: function() { playTone(500, 'sine', 0.15, 0.1); setTimeout(function(){ playTone(700, 'sine', 0.15, 0.08); }, 80); },
        complete: function() {
          var melody = [523, 659, 784, 1047, 784, 1047];
          melody.forEach(function(n, i) { setTimeout(function() { playTone(n, 'sine', 0.25, 0.3); }, i * 150); });
        },
        warning: function() { playTone(200, 'square', 0.3, 0.15); },
        energyUp: function() {
          playTone(400, 'sine', 0.15, 0.15);
          setTimeout(function() { playTone(500, 'sine', 0.15, 0.15); }, 80);
          setTimeout(function() { playTone(650, 'sine', 0.2, 0.2); }, 160);
        },
        energyDown: function() {
          playTone(500, 'sine', 0.15, 0.15);
          setTimeout(function() { playTone(350, 'sine', 0.2, 0.15); }, 100);
        },
        shieldUp: function() {
          playTone(400, 'sine', 0.2, 0.2);
          setTimeout(function() { playTone(600, 'sine', 0.2, 0.2); }, 100);
          setTimeout(function() { playTone(800, 'sine', 0.3, 0.25); }, 200);
          setTimeout(function() { playTone(1000, 'sine', 0.4, 0.2); }, 300);
        },
        virusAlert: function() {
          playTone(200, 'square', 0.1, 0.15);
          setTimeout(function() { playTone(180, 'square', 0.1, 0.12); }, 100);
          setTimeout(function() { playTone(160, 'square', 0.15, 0.1); }, 200);
        },
        silence: function() {
          var c = getCtx(); if (!c) return;
          try {
            var osc = c.createOscillator(); var gain = c.createGain();
            osc.type = 'sine'; osc.frequency.setValueAtTime(80, c.currentTime);
            gain.gain.setValueAtTime(0.08 * masterVol, c.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 2);
            osc.connect(gain); gain.connect(c.destination);
            osc.start(c.currentTime); osc.stop(c.currentTime + 2);
          } catch(e) {}
        },
        heartbeat: function() {
          playTone(60, 'sine', 0.15, 0.2);
          setTimeout(function() { playTone(50, 'sine', 0.2, 0.15); }, 200);
        },
        tension: function() {
          playTone(150, 'sawtooth', 0.5, 0.08);
          setTimeout(function() { playTone(155, 'sawtooth', 0.5, 0.06); }, 100);
        },
        whoosh: function() {
          var c = getCtx(); if (!c) return;
          try {
            var osc = c.createOscillator(); var gain = c.createGain();
            osc.type = 'sine'; osc.frequency.setValueAtTime(200, c.currentTime);
            osc.frequency.exponentialRampToValueAtTime(2000, c.currentTime + 0.15);
            gain.gain.setValueAtTime(0.1 * masterVol, c.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.2);
            osc.connect(gain); gain.connect(c.destination);
            osc.start(c.currentTime); osc.stop(c.currentTime + 0.2);
            playNoise(0.1, 0.05);
          } catch(e) {}
        }
      };
    })();

    /* ================================================================
       PARTICLE SYSTEM — Ambient floating particles
       ================================================================ */
    var ParticleSystem = (function() {
      var canvas, ctxP, particles = [], running = false, animId = null, resizeBound = false;

      function init() {
        canvas = document.getElementById('particle-canvas');
        if (!canvas) return;
        ctxP = canvas.getContext('2d');
        if (!ctxP) return;
        if (animId) { cancelAnimationFrame(animId); animId = null; }
        particles = [];
        resize();
        for (var i = 0; i < 30; i++) particles.push(createParticle());
        running = true;
        animate();
        if (!resizeBound) {
          window.addEventListener('resize', resize);
          resizeBound = true;
        }
      }

      function resize() {
        var container = document.getElementById('game-container');
        if (!container || !canvas) return;
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight;
      }

      function createParticle() {
        var isCh2 = false, isCh3 = false, isCh4 = false, isCh5 = false;
        var container = document.getElementById('game-container');
        if (container) {
          isCh2 = container.classList.contains('ch2-mode');
          isCh3 = container.classList.contains('ch3-mode');
          isCh4 = container.classList.contains('ch4-mode');
          isCh5 = container.classList.contains('ch5-mode');
        }
        return {
          x: Math.random() * (canvas ? canvas.width : 800),
          y: Math.random() * (canvas ? canvas.height : 600),
          vx: (Math.random() - 0.5) * 0.3,
          vy: -Math.random() * 0.4 - 0.1,
          size: Math.random() * 2 + 0.5,
          alpha: Math.random() * 0.4 + 0.1,
          hue: isCh2
            ? (Math.random() > 0.5 ? 270 : 330)
            : isCh3
              ? (Math.random() > 0.5 ? 0 : 350)
              : isCh4
                ? (Math.random() > 0.5 ? 200 : 210)
                : isCh5
                  ? (Math.random() > 0.5 ? 120 : 140)
                : (Math.random() > 0.5 ? 230 : 270)
        };
      }

      function animate() {
        if (!running || !ctxP || !canvas) return;
        ctxP.clearRect(0, 0, canvas.width, canvas.height);

        for (var i = particles.length - 1; i >= 0; i--) {
          var p = particles[i];
          p.x += p.vx; p.y += p.vy;
          p.alpha += (Math.random() - 0.5) * 0.01;
          if (p.alpha < 0.05) p.alpha = 0.05;
          if (p.alpha > 0.5) p.alpha = 0.5;

          // Life-based burst particles
          if (p.life !== undefined) {
            p.life--;
            p.alpha *= 0.95;
            if (p.life <= 0) { particles.splice(i, 1); continue; }
          }

          if (p.y < -10) { p.y = canvas.height + 10; p.x = Math.random() * canvas.width; }
          if (p.x < -10) p.x = canvas.width + 10;
          if (p.x > canvas.width + 10) p.x = -10;

          ctxP.beginPath();
          ctxP.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctxP.fillStyle = 'hsla(' + p.hue + ', 70%, 70%, ' + p.alpha + ')';
          ctxP.fill();
        }
        animId = requestAnimationFrame(animate);
      }

      function burst(x, y, count, color) {
        if (!ctxP || !canvas) return;
        var container = document.getElementById('game-container');
        if (!container) return;
        var rect = container.getBoundingClientRect();
        var cx = x - rect.left, cy = y - rect.top;
        var c = count || 12;
        for (var i = 0; i < c; i++) {
          var angle = (Math.PI * 2 * i) / c;
          var speed = 1 + Math.random() * 2;
          particles.push({
            x: cx, y: cy,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            size: Math.random() * 2.5 + 1,
            alpha: 0.7,
            hue: color === 'green' ? 120 : color === 'red' ? 0 : color === 'gold' ? 45 : 230,
            life: 35
          });
        }
      }

      function stop() { running = false; if (animId) cancelAnimationFrame(animId); }

      return { init: init, burst: burst, stop: stop, resize: resize };
    })();

    /* ================================================================
       SCREEN EFFECTS
       ================================================================ */
    function screenFlash(color, duration) {
      var el = document.getElementById('screen-flash');
      if (!el) return;
      el.style.background = color || 'rgba(255,255,255,0.3)';
      el.style.opacity = '1';
      setTimeout(function() { el.style.opacity = '0'; }, duration || 150);
    }

    function getGameContainer() {
      return document.getElementById('game-container');
    }

    function toContainerPoint(x, y) {
      var container = getGameContainer();
      if (!container) return { x: x || 0, y: y || 0, width: 0, height: 0 };
      var rect = container.getBoundingClientRect();
      var px = (typeof x === 'number') ? (x - rect.left) : (rect.width / 2);
      var py = (typeof y === 'number') ? (y - rect.top) : (rect.height / 2);
      return { x: px, y: py, width: rect.width, height: rect.height };
    }

    function floatFeedback(text, x, y, color) {
      var container = getGameContainer();
      if (!container) return;
      var point = toContainerPoint(x, y);
      var el = document.createElement('div');
      el.className = 'float-feedback';
      el.textContent = text;
      el.style.color = color || '#fff';
      el.style.left = Math.max(20, Math.min(point.x, point.width - 100)) + 'px';
      el.style.top = Math.max(20, Math.min(point.y, point.height - 20)) + 'px';
      container.appendChild(el);
      setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 1300);
    }

    function showToast(msg, duration) {
      var container = getGameContainer();
      if (!container) return;
      var existing = container.querySelector('.toast-notification');
      if (existing) existing.parentNode.removeChild(existing);
      var t = document.createElement('div');
      t.className = 'toast-notification';
      t.textContent = msg;
      container.appendChild(t);
      requestAnimationFrame(function() { requestAnimationFrame(function() { t.classList.add('show'); }); });
      setTimeout(function() {
        t.classList.remove('show');
        setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 400);
      }, duration || 2500);
    }

    var CourseXP = (function() {
      var STORAGE_KEY = 'course_xp_v1';
      var CHAPTER_MAX = { ch1: 100, ch2: 120, ch3: 120, ch4: 130, ch5: 150 };

      function clamp(v, min, max) {
        var n = Number(v);
        if (!isFinite(n)) n = 0;
        if (n < min) return min;
        if (n > max) return max;
        return n;
      }

      function defaults() {
        return { ch1: 0, ch2: 0, ch3: 0, ch4: 0, ch5: 0 };
      }

      function getChapterMax(chapterId) {
        return CHAPTER_MAX[chapterId] || 100;
      }

      function load() {
        var map = defaults();
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            var parsed = JSON.parse(raw);
            Object.keys(map).forEach(function(k) {
              if (parsed && Object.prototype.hasOwnProperty.call(parsed, k)) {
                map[k] = clamp(parsed[k], 0, getChapterMax(k));
              }
            });
          }
        } catch (e) {}
        return map;
      }

      function save(map) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(map)); } catch (e) {}
      }

      function getChapterXP(chapterId) {
        return load()[chapterId] || 0;
      }

      function setChapterXP(chapterId, xp) {
        var map = load();
        if (!Object.prototype.hasOwnProperty.call(map, chapterId)) return 0;
        map[chapterId] = clamp(xp, 0, getChapterMax(chapterId));
        save(map);
        return map[chapterId];
      }

      function addChapterXP(chapterId, delta) {
        var cur = getChapterXP(chapterId);
        return setChapterXP(chapterId, cur + (Number(delta) || 0));
      }

      function resetChapterXP(chapterId) {
        return setChapterXP(chapterId, 0);
      }

      function syncChapterXP(chapterId, legacyXP) {
        var map = load();
        if (!Object.prototype.hasOwnProperty.call(map, chapterId)) return 0;
        var current = map[chapterId];
        var legacy = clamp(legacyXP, 0, getChapterMax(chapterId));
        if (current <= 0 && legacy > 0) {
          map[chapterId] = legacy;
          save(map);
          return legacy;
        }
        return current;
      }

      function getTotalXP() {
        var map = load();
        var total = 0;
        Object.keys(map).forEach(function(k) { total += map[k] || 0; });
        return total;
      }

      function getTotalMax() {
        var total = 0;
        Object.keys(CHAPTER_MAX).forEach(function(k) { total += CHAPTER_MAX[k]; });
        return total;
      }

      function getTotalPercent() {
        var max = getTotalMax();
        if (!max) return 0;
        return Math.min(100, (getTotalXP() / max) * 100);
      }

      return {
        getChapterMax: getChapterMax,
        getChapterXP: getChapterXP,
        setChapterXP: setChapterXP,
        addChapterXP: addChapterXP,
        resetChapterXP: resetChapterXP,
        syncChapterXP: syncChapterXP,
        getTotalPercent: getTotalPercent
      };
    })();

