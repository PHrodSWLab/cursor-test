      function ch5FinishChapter() {
        try {
          localStorage.setItem('chapter5_completed', 'true');
          localStorage.setItem('chapter5_completedAt', String(Date.now()));
        } catch (e) {}

        SFX.complete();
        screenFlash('rgba(22,163,74,0.3)', 500);
        var container = ch5Container();
        if (!container) return;
        showCompletionModal({
          container: container,
          innerId: 'ch5-complete-modal-inner',
          closeBtnId: 'ch5-close-modal-btn',
          menuBtnId: 'ch5-menu-modal-btn',
          onMenu: function() {
            ch5GameStarted = false;
            returnToGameMenu();
          },
