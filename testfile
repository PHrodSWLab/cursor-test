        var i = 0;
        var skipTyping = false;
        var charCount = 0;
        var typingDone = false;

        function finishTyping() {
          if (typingDone) return;
          typingDone = true;
          var timerId = getTimer();
          if (timerId) { clearInterval(timerId); setTimer(null); }
          textEl.textContent = opts.text;
          textEl.classList.add('typing-done');

          if (opts.choices) {
            opts.choices.forEach(function(c, idx) {
              var btn = document.createElement('button');
