    function scene01_hook() {
      var r = document.getElementById('scene-renderer');

      if (typeof THREE === 'undefined') {
        r.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;flex-direction:column;">' +
