        if (response.correct) {
          element.classList.add('selected');
          SFX.correct();
          screenFlash('rgba(76,175,80,0.15)', 200);
          var rect = element.getBoundingClientRect();
          ParticleSystem.burst(rect.left + 100, rect.top + 10, 15, 'green');
          ch3AddXP(15);
          ch3GameState.updateStats(response.outcome.k, response.outcome.p, response.outcome.c);
        } else {
          element.classList.add('wrong');
          SFX.incorrect();
          screenFlash('rgba(244,67,54,0.15)', 200);
          ch3AddXP(3);
          if (correctIdx >= 0 && allOpts[correctIdx]) {
            setTimeout(function() {
              allOpts[correctIdx].classList.remove('disabled');
              allOpts[correctIdx].classList.add('selected');
              allOpts[correctIdx].style.opacity = '1';
            }, 800);
          }
