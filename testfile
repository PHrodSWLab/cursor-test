            '<div style="margin-top:25px;padding-top:15px;border-top:1px solid rgba(255,255,255,0.1);">' +
              '<button class="btn-main" id="ch5-close-modal-btn" style="margin-top:10px;">關閉</button>' +
              '<button class="btn-main" id="ch5-menu-modal-btn" style="margin-top:10px;">返回課程地圖</button>' +
            '</div></div>'
        });
      }

      function ch5InitResetButton() {
        bindDoubleConfirmReset(function() {
          ch5ClearAllTimers();
          ch5GameState.resetProgress();
          ch5LoadScene(1);
        });
      }

      function ch5CheckChapter4() {
        try { return localStorage.getItem('chapter4_completed') === 'true'; }
        catch (e) { return false; }
      }

      function ch5StartGame() {
        if (ch5GameStarted) return;
        ch5GameStarted = true;

        ParticleSystem.init();
        ch5InitResetButton();
        initAudioOnFirstInteraction();

        ch5GameState.loadProgress();
        if (!ch5CheckChapter4()) {
          ch5GameState.playerData.ch4Done = false;
          showToast('⚠️ 建議先完成 Chapter 4', 4000);
        } else {
          ch5GameState.playerData.ch4Done = true;
        }
        ch5UpdateProgress();
        ch5GameState.updateDisplay();
        ChapterFramework.syncXP(ch5GameState, 'ch5', 150);

        if (ch5GameState.currentScene === 0) ch5GameState.currentScene = 1;
        ch5LoadScene(ch5GameState.currentScene);
      }

      function ch5Init() {
        runLoadingBootstrap(ch5StartGame);
      }

      function start() {
        ch5SetupModeUI();
        ch5BuildLoadingOverlay();
        ch5Init();
      }

      return { start: start };
    })();

    /* ================================================================
       INITIALIZATION
       ================================================================ */
    function init() {
      runLoadingBootstrap(startGame);
    }

    var _gameStarted = false;
    function startGame() {
      if (_gameStarted) return;
      _gameStarted = true;

      ParticleSystem.init();
      initResetButton();
      initAudioOnFirstInteraction();

      GameState.loadProgress();
      updateProgress();
      GameState.updateMoralCompass();
      ChapterFramework.syncXP(GameState, 'ch1', 100);

      if (GameState.currentScene === 0) GameState.currentScene = 1;
      loadScene(GameState.currentScene);
    }

    window.addEventListener('DOMContentLoaded', initGameMenu);

    // Handle visibility change — pause/resume particle system
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        // could pause animations here
      } else {
        ParticleSystem.resize();
      }
    });

    /* ===== WORDPRESS EMBED SAFETY ===== */
    (function() {
      if (!document.getElementById('game-container')) return;
      var style = document.createElement('style');
      style.textContent = '#game-container p{margin:0!important}#game-container br{display:inline}#game-container img{display:none}#game-container .wp-block-image{display:none}';
      document.head.appendChild(style);
    })();
  </script>
