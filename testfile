<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Chapter 1: 寄生蟲的解剖學 | 獠牙與慈悲</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; background: transparent; }
    body { font-family: 'Microsoft JhengHei', 'Noto Sans TC', 'PingFang TC', 'Helvetica Neue', sans-serif; background: transparent; color: #fff; overflow: hidden; -webkit-tap-highlight-color: transparent; }

    #game-container {
      width: 100%; max-width: 1024px; aspect-ratio: 4/3;
      margin: 20px auto; position: relative;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      overflow: hidden; box-shadow: none; border-radius: 8px;
    }

    /* ===== GAME MENU LAYER ===== */
    #game-menu {
      --menu-bg: #030510;
      --menu-ink: #e8e0f0;
      --menu-gold: #fbbf24;
      --menu-purple: #a855f7;
      --menu-cyan: #06b6d4;
      --menu-red: #ef4444;
      --menu-amber: #f59e0b;
      position: absolute;
      inset: 0;
      z-index: 12050;
      overflow: hidden;
      background: var(--menu-bg);
      color: var(--menu-ink);
      font-family: 'Noto Serif TC', serif;
    }
    #game-menu.hidden { display: none; }

    #menu-starfield {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    #menu-app {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
    }
    #menu-app::-webkit-scrollbar { width: 6px; }
    #menu-app::-webkit-scrollbar-thumb { background: rgba(251,191,36,0.3); border-radius: 4px; }

    #game-menu .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 56px 20px 40px;
      position: relative;
    }
    #game-menu .hero-glyph {
      font-size: clamp(44px, 8vw, 72px);
      line-height: 1;
      margin-bottom: 20px;
      filter: drop-shadow(0 0 30px rgba(251,191,36,0.5));
      animation: menu-wolf-float 4s ease-in-out infinite;
    }
    @keyframes menu-wolf-float {
      0%,100% { transform: translateY(0) rotate(-2deg); }
      50% { transform: translateY(-8px) rotate(2deg); }
    }
    #game-menu .hero-tag {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 3px;
      color: var(--menu-gold);
      text-transform: uppercase;
      margin-bottom: 12px;
      opacity: 0.75;
    }
    #game-menu .hero-title {
      font-size: clamp(28px, 5vw, 48px);
      font-weight: 900;
      line-height: 1.1;
      background: linear-gradient(135deg, #fbbf24 0%, #f0abfc 50%, #67e8f9 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 10px;
    }
    #game-menu .hero-sub {
      font-size: clamp(12px, 1.8vw, 16px);
      color: rgba(232,224,240,0.55);
      margin-bottom: 24px;
      letter-spacing: 1px;
    }

    #game-menu .progress-ring-wrap {
      display: flex;
      align-items: center;
      gap: 16px;
      background: rgba(0,0,0,0.5);
      border: 1px solid rgba(251,191,36,0.2);
      border-radius: 50px;
      padding: 12px 20px;
      backdrop-filter: blur(10px);
    }
    #game-menu .progress-ring-wrap svg { width: 42px; height: 42px; }
    #game-menu .pr-track { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 4; }
    #game-menu .pr-fill {
      fill: none;
      stroke: var(--menu-gold);
      stroke-width: 4;
      stroke-linecap: round;
      stroke-dasharray: 126;
      stroke-dashoffset: 126;
      transition: stroke-dashoffset 1.5s cubic-bezier(.4,0,.2,1);
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
    #game-menu .pr-info h4 { font-size: 14px; font-weight: 700; color: var(--menu-ink); }
    #game-menu .pr-info p {
      font-size: 11px;
      color: rgba(232,224,240,0.5);
      font-family: 'Space Mono', monospace;
      margin-top: 3px;
    }

    #game-menu .divider {
      width: 100px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--menu-gold), transparent);
      margin: 0 auto 32px;
      opacity: 0.4;
    }

    #game-menu .starmap {
      max-width: 920px;
      margin: 0 auto;
      padding: 0 18px 34px;
    }

    #game-menu .part-block {
      margin-bottom: 38px;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    #game-menu .part-block.visible { opacity: 1; transform: translateY(0); }

    #game-menu .part-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }
    #game-menu .part-badge {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 900;
      font-family: 'Space Mono', monospace;
      border: 2px solid;
      flex-shrink: 0;
    }
    #game-menu .part-header-text h3 { font-size: clamp(15px, 2.2vw, 19px); font-weight: 700; }
    #game-menu .part-header-text p {
      font-size: 11px;
      color: rgba(232,224,240,0.45);
      font-family: 'Space Mono', monospace;
      margin-top: 2px;
      letter-spacing: 1px;
    }

    #game-menu .part-1 .part-badge { border-color: var(--menu-red); color: var(--menu-red); background: rgba(239,68,68,0.1); }
    #game-menu .part-2 .part-badge { border-color: var(--menu-amber); color: var(--menu-amber); background: rgba(245,158,11,0.1); }
    #game-menu .part-3 .part-badge { border-color: var(--menu-purple); color: var(--menu-purple); background: rgba(168,85,247,0.12); }
    #game-menu .part-4 .part-badge { border-color: var(--menu-cyan); color: var(--menu-cyan); background: rgba(6,182,212,0.1); }
    #game-menu .part-1 .part-header-text h3 { color: var(--menu-red); }
    #game-menu .part-2 .part-header-text h3 { color: var(--menu-amber); }
    #game-menu .part-3 .part-header-text h3 { color: var(--menu-purple); }
    #game-menu .part-4 .part-header-text h3 { color: var(--menu-cyan); }

    #game-menu .chapters-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    #game-menu .ch-card {
      position: relative;
      border-radius: 12px;
      padding: 18px 16px;
      border: 1px solid rgba(255,255,255,0.07);
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(6px);
      cursor: pointer;
      transition: all 0.35s cubic-bezier(.4,0,.2,1);
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: block;
    }
    #game-menu .ch-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 12px;
      opacity: 0;
      transition: opacity 0.35s;
    }
    #game-menu .ch-card:hover { transform: translateY(-3px); }
    #game-menu .ch-card:hover::before { opacity: 1; }
    #game-menu .ch-card.done {
      border-color: rgba(251,191,36,0.25);
      background: rgba(120,83,15,0.12);
    }
    #game-menu .ch-card.done::before {
      background: radial-gradient(ellipse at top left, rgba(251,191,36,0.08), transparent);
    }
    #game-menu .ch-card.current {
      border-color: rgba(168,85,247,0.45);
      background: rgba(88,28,135,0.15);
      box-shadow: 0 0 24px rgba(168,85,247,0.12);
    }
    #game-menu .ch-card.current::before {
      background: radial-gradient(ellipse at top left, rgba(168,85,247,0.12), transparent);
    }
    #game-menu .ch-card.locked {
      opacity: 0.38;
      cursor: not-allowed;
    }

    #game-menu .ch-num {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      letter-spacing: 1.5px;
      color: rgba(232,224,240,0.35);
      margin-bottom: 8px;
      text-transform: uppercase;
    }
    #game-menu .ch-icon-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 9px;
    }
    #game-menu .ch-icon { font-size: 24px; line-height: 1; }
    #game-menu .ch-status { font-size: 16px; }
    #game-menu .ch-title {
      font-size: 13px;
      font-weight: 700;
      line-height: 1.35;
      margin-bottom: 5px;
      color: var(--menu-ink);
    }
    #game-menu .ch-subtitle {
      font-size: 10px;
      color: rgba(232,224,240,0.4);
      line-height: 1.5;
      font-family: 'Space Mono', monospace;
    }
    #game-menu .ch-prog {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: rgba(255,255,255,0.05);
      overflow: hidden;
      border-radius: 0 0 12px 12px;
    }
    #game-menu .ch-prog-fill {
      height: 100%;
      border-radius: 2px;
      transition: width 1.2s ease;
    }
    #game-menu .done .ch-prog-fill { background: var(--menu-gold); width: 100%; }
    #game-menu .current .ch-prog-fill { background: var(--menu-purple); width: 50%; animation: menu-pulse 2s ease-in-out infinite; }
    #game-menu .locked .ch-prog-fill { width: 0; }
    @keyframes menu-pulse { 0%,100%{opacity:0.5;} 50%{opacity:1;} }
    #game-menu .ch-card.done .ch-star {
      position: absolute;
      top: 8px;
      right: 10px;
      font-size: 9px;
      color: var(--menu-gold);
      opacity: 0.6;
    }

    #game-menu .course-info {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 20px 30px;
      text-align: center;
    }
    #game-menu .course-info h2 {
      font-size: 18px;
      font-weight: 700;
      color: var(--menu-gold);
      margin-bottom: 12px;
    }
    #game-menu .course-info p {
      font-size: 13px;
      line-height: 1.8;
      color: rgba(232,224,240,0.55);
      margin-bottom: 10px;
    }
    #game-menu .info-pills {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }
    #game-menu .info-pill {
      background: rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 50px;
      padding: 7px 14px;
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: rgba(232,224,240,0.6);
      letter-spacing: 0.5px;
    }
    #game-menu .info-pill span { color: var(--menu-gold); font-weight: 700; }

    #game-menu footer {
      text-align: center;
      padding: 18px 20px 28px;
      border-top: 1px solid rgba(255,255,255,0.05);
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: rgba(232,224,240,0.25);
      letter-spacing: 1px;
    }
    #game-menu footer strong { color: rgba(251,191,36,0.45); }

    #menu-tooltip {
      position: absolute;
      background: rgba(0,0,0,0.95);
      border: 1px solid rgba(251,191,36,0.3);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 12px;
      color: var(--menu-ink);
      pointer-events: none;
      z-index: 13000;
      max-width: 220px;
      line-height: 1.6;
      display: none;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
    }
    #menu-tooltip.show { display: block; }

    /* ===== AMBIENT PARTICLE LAYER ===== */
    #particle-canvas {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      z-index: 1; pointer-events: none; opacity: 0.4;
    }

    /* ===== PROGRESS BAR ===== */
    #progress-bar {
      position: absolute; top: 0; left: 0; width: 100%; height: 5%;
      background: rgba(0,0,0,0.9); display: flex; align-items: center;
      padding: 0 20px; z-index: 100; backdrop-filter: blur(10px);
    }
    .progress-track { flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; margin: 0 15px; position: relative; }
    .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); transition: width 0.8s ease; position: relative; }
    .progress-fill::after { content: ''; position: absolute; right: 0; top: -2px; width: 10px; height: 10px; background: #fff; border-radius: 50%; box-shadow: 0 0 10px #667eea, 0 0 20px #764ba2; }
    .scene-counter { color: rgba(255,255,255,0.7); font-size: 12px; font-family: 'Courier New', monospace; white-space: nowrap; }

    /* ===== XP INDICATOR ===== */
    #xp-bar {
      position: absolute; top: 5%; left: 0; width: 100%; height: 3px;
      background: rgba(0,0,0,0.5); z-index: 100; overflow: hidden;
    }
    #xp-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #FFD700, #FFA500); transition: width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }

    /* ===== MORAL COMPASS ===== */
    #moral-compass {
      position: absolute; top: 9%; right: 2%; width: 110px; height: 110px;
      background: rgba(0,0,0,0.85); border-radius: 50%; border: 2px solid rgba(255,255,255,0.15);
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      z-index: 100; font-size: 11px; backdrop-filter: blur(10px);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    #moral-compass:hover { transform: scale(1.08); box-shadow: 0 0 25px rgba(102, 126, 234, 0.3); }
    #moral-compass.pulse-kindness { animation: pulse-green 0.6s ease; }
    #moral-compass.pulse-power { animation: pulse-red 0.6s ease; }
    @keyframes pulse-green { 0%,100%{ box-shadow: 0 0 5px rgba(76,175,80,0.2); } 50%{ box-shadow: 0 0 30px rgba(76,175,80,0.8); } }
    @keyframes pulse-red { 0%,100%{ box-shadow: 0 0 5px rgba(244,67,54,0.2); } 50%{ box-shadow: 0 0 30px rgba(244,67,54,0.8); } }
    .compass-row { display: flex; align-items: center; gap: 5px; margin: 3px 0; }
    .compass-label { font-size: 9px; color: #aaa; width: 35px; }
    .compass-value { font-size: 16px; font-weight: bold; width: 30px; text-align: right; transition: all 0.3s ease; }
    .compass-value.kindness { color: #4CAF50; }
    .compass-value.power { color: #F44336; }
    .compass-value.changed { animation: value-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
    @keyframes value-pop { 0%{ transform: scale(1); } 50%{ transform: scale(1.5); } 100%{ transform: scale(1); } }

    /* ===== SCENE RENDERER ===== */
    #scene-renderer {
      width: 100%; height: 100%; position: absolute; top: 0; left: 0;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      padding: 8% 5% 2% 5%; z-index: 10;
    }

    /* ===== DIALOGUE BOX ===== */
    #dialogue-box {
      position: absolute; bottom: 0; left: 0; width: 100%; min-height: 25%;
      background: linear-gradient(to top, rgba(0,0,0,0.97), rgba(0,0,0,0.88));
      padding: 20px 30px; display: none; flex-direction: column; justify-content: center;
      z-index: 200; border-top: 1px solid rgba(102, 126, 234, 0.3);
      backdrop-filter: blur(15px);
    }
    #dialogue-box.active { display: flex; animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .dialogue-speaker {
      color: #667eea; font-size: 14px; font-weight: bold; margin-bottom: 8px;
      text-transform: uppercase; letter-spacing: 2px;
      text-shadow: 0 0 10px rgba(102, 126, 234, 0.5);
    }
    .dialogue-text {
      color: #fff; font-size: 16px; line-height: 1.7; margin-bottom: 15px; min-height: 50px;
      cursor: pointer;
    }
    .dialogue-text::after {
      content: '▼'; display: inline-block; animation: blink-caret 1s infinite;
      margin-left: 5px; font-size: 10px; color: rgba(255,255,255,0.4);
    }
    .dialogue-text.typing-done::after { display: none; }
    @keyframes blink-caret { 0%,100%{ opacity: 0; } 50%{ opacity: 1; } }

    .dialogue-options { display: flex; gap: 12px; flex-wrap: wrap; }

    .option-button {
      flex: 1; min-width: 200px; padding: 14px 20px;
      background: rgba(102, 126, 234, 0.15); border: 2px solid rgba(102, 126, 234, 0.4);
      color: #fff; font-size: 14px; border-radius: 8px; cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); font-family: inherit;
      position: relative; overflow: hidden;
    }
    .option-button::before {
      content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.2), transparent);
      transition: left 0.5s ease;
    }
    .option-button:hover { background: rgba(102, 126, 234, 0.35); border-color: #667eea; transform: translateY(-3px) scale(1.02); box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3); }
    .option-button:hover::before { left: 100%; }
    .option-button:active { transform: translateY(0) scale(0.98); }
    .option-button.appear { animation: btn-appear 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both; }

    @keyframes btn-appear { from { opacity: 0; transform: translateY(20px) scale(0.8); } to { opacity: 1; transform: translateY(0) scale(1); } }

    .continue-button {
      display: block; margin: 20px auto; padding: 14px 35px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none; color: #fff; font-size: 16px; font-weight: bold;
      border-radius: 8px; cursor: pointer; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      font-family: inherit; position: relative; overflow: hidden;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }
    .continue-button::after {
      content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
      opacity: 0; transition: opacity 0.3s;
    }
    .continue-button:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 8px 30px rgba(102, 126, 234, 0.5); }
    .continue-button:hover::after { opacity: 1; }
    .continue-button:active { transform: translateY(0) scale(0.97); }
    .continue-button:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; box-shadow: none !important; }

    /* ===== TUTORIAL / CONTENT CONTAINERS ===== */
    .tutorial-container, .dimMak-container, .reflection-container, .challenge-container, .summary-container {
      width: 100%; height: 100%; padding: 40px 30px; overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .tutorial-container h2, .dimMak-container h2, .challenge-container h2, .reflection-container h2, .summary-container h2 {
      text-align: center; margin-bottom: 20px; font-size: 22px;
    }

    /* ===== DROP ZONES ===== */
    .zones-container { display: flex; gap: 20px; margin-bottom: 20px; min-height: 120px; }
    .drop-zone {
      flex: 1; min-height: 120px; border: 3px dashed rgba(255,255,255,0.3);
      border-radius: 12px; padding: 15px; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
    }
    .drop-zone h3 { font-size: 14px; margin-bottom: 10px; }
    .drop-zone.healthy { border-color: rgba(76, 175, 80, 0.5); background: rgba(76, 175, 80, 0.05); }
    .drop-zone.exploitation { border-color: rgba(244, 67, 54, 0.5); background: rgba(244, 67, 54, 0.05); }
    .drop-zone.drag-over { background: rgba(255,255,255,0.12); border-style: solid; transform: scale(1.03); box-shadow: 0 0 25px rgba(255,255,255,0.1); }
    .drop-zone .zone-count {
      position: absolute; bottom: 8px; right: 12px; font-size: 11px; color: rgba(255,255,255,0.4);
    }

    /* ===== DRAG CARDS ===== */
    .cards-container { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 15px; }
    .drag-card {
      background: #2a2a3e; border: 2px solid #444; border-radius: 8px;
      padding: 12px; cursor: grab; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); font-size: 13px;
      user-select: none; -webkit-user-select: none; position: relative;
    }
    .drag-card:hover:not(.placed) { transform: translateY(-2px) scale(1.02); box-shadow: 0 6px 20px rgba(0,0,0,0.4); border-color: #667eea; }
    .drag-card:active:not(.placed) { cursor: grabbing; transform: scale(1.05); z-index: 50; }
    .drag-card.correct { background: rgba(76, 175, 80, 0.25); border-color: #4CAF50; cursor: default; animation: correct-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .drag-card.incorrect { background: rgba(244, 67, 54, 0.25); border-color: #F44336; animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
    .drag-card.placed { opacity: 0.5; pointer-events: none; cursor: default; transform: scale(0.95); }
    .drag-card .card-icon { position: absolute; top: 8px; right: 10px; font-size: 16px; opacity: 0; transition: opacity 0.3s; }
    .drag-card.correct .card-icon { opacity: 1; }

    @keyframes correct-pop { 0%{ transform: scale(1); } 40%{ transform: scale(1.15); } 100%{ transform: scale(0.95); } }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      15% { transform: translateX(-8px) rotate(-2deg); }
      30% { transform: translateX(8px) rotate(2deg); }
      45% { transform: translateX(-6px) rotate(-1deg); }
      60% { transform: translateX(6px) rotate(1deg); }
