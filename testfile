      } catch(e) {
        r.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;"><p style="color:rgba(255,255,255,0.5);">3D 載入中...</p></div>';
        startScene01Dialogue();
        return;
      }
      renderer.setSize(cW, cH);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.domElement.style.width = '100%';
      renderer.domElement.style.height = '100%';
      r.appendChild(renderer.domElement);
      camera.position.z = 5;
      _activeThreeRenderer = renderer;

      scene3d.add(new THREE.AmbientLight(0x404040, 2));
      var light = new THREE.DirectionalLight(0xffffff, 1);
      light.position.set(5, 5, 5);
      scene3d.add(light);

      var protag = new THREE.Mesh(
        new THREE.SphereGeometry(1, 32, 32),
        new THREE.MeshPhongMaterial({ color: 0xFFD700, emissive: 0xFFAA00, emissiveIntensity: 1.0, transparent: true, opacity: 0.9 })
      );
      scene3d.add(protag);

      var parasites = [];
      for (var p = 0; p < 5; p++) {
        var parasite = new THREE.Mesh(
          new THREE.SphereGeometry(0.12, 16, 16),
          new THREE.MeshPhongMaterial({ color: 0x8B0000, emissive: 0xFF0000, emissiveIntensity: 0.5, transparent: true, opacity: 0.7 })
        );
        parasite._angle = (Math.PI * 2 * p) / 5;
        parasite._radius = 2 + Math.random() * 0.5;
        parasite._speed = 0.005 + Math.random() * 0.005;
        parasite._yOffset = (Math.random() - 0.5) * 1.5;
        scene3d.add(parasite);
        parasites.push(parasite);
      }

      var time = 0;
      function animate() {
        _activeAnimationFrame = requestAnimationFrame(animate);
        time += 0.01;
        protag.rotation.y += 0.005;
        protag.material.emissiveIntensity = 0.5 + Math.sin(time * 2) * 0.3;

        parasites.forEach(function(par) {
          par._angle += par._speed;
          par.position.x = Math.cos(par._angle) * par._radius;
          par.position.z = Math.sin(par._angle) * par._radius;
          par.position.y = par._yOffset + Math.sin(time * 3 + par._angle) * 0.3;
          par._radius = Math.max(1.3, par._radius - 0.0003);
        });

        renderer.render(scene3d, camera);
      }
      animate();

